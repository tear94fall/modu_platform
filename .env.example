# 이 파일은 config-service 만 읽는다(부트스트랩 시크릿). 다른 시크릿은 전부 config-repo 에 {cipher} 로 — README '시크릿 지도'.
# config-repo 의 {cipher} 값을 복호화하는 키.
ENCRYPT_KEY=
# config-service 의 /api-admin·/encrypt·/decrypt 를 여는 토큰. config-repo application.yml 의 modu.internal-api.token({cipher})과 같은 값이어야 한다.
INTERNAL_API_TOKEN=
# 백오피스 개발 서버 출처(CORS). 도커로 띄운 modu_admin(8081)은 프록시를 써서 이 값이 필요 없다.
ADMIN_ALLOWED_ORIGIN=http://localhost:5173
# Pinpoint 에이전트 옵션(선택). 비우면 에이전트 없이 뜬다.
CONFIG_AGENT_OPTS=
GATEWAY_AGENT_OPTS=

# config-service 가 config-repo 의 {cipher} 값을 복호화하는 키. modu_chat backend/.env 에 있던 값을 그대로 쓴다.
ENCRYPT_KEY=
# 서비스 간(/api-internal/**) 호출 토큰. modu_messenger, modu_commerce 의 .env 와 같은 값이어야 한다.
INTERNAL_API_TOKEN=
# 백오피스 개발 서버 출처(CORS). 도커로 띄운 modu_admin(8081)은 프록시를 써서 이 값이 필요 없다.
ADMIN_ALLOWED_ORIGIN=http://localhost:5173
# Pinpoint 에이전트 옵션(선택). 비우면 에이전트 없이 뜬다.
CONFIG_AGENT_OPTS=
DISCOVERY_AGENT_OPTS=
GATEWAY_AGENT_OPTS=
